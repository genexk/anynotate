{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$comment": "Result types copied from the Model Context Protocol specification, revision 2026-07-28 (https://github.com/modelcontextprotocol/specification/blob/main/schema/2026-07-28/schema.json, Apache-2.0), with descriptions removed. Used only by tests.",
 "$defs": {
  "Annotations": {
   "properties": {
    "audience": {
     "items": {
      "$ref": "#/$defs/Role"
     },
     "type": "array"
    },
    "lastModified": {
     "type": "string"
    },
    "priority": {
     "maximum": 1,
     "minimum": 0,
     "type": "number"
    }
   },
   "type": "object"
  },
  "AudioContent": {
   "properties": {
    "_meta": {
     "$ref": "#/$defs/MetaObject"
    },
    "annotations": {
     "$ref": "#/$defs/Annotations"
    },
    "data": {
     "format": "byte",
     "type": "string"
    },
    "mimeType": {
     "type": "string"
    },
    "type": {
     "const": "audio",
     "type": "string"
    }
   },
   "required": [
    "data",
    "mimeType",
    "type"
   ],
   "type": "object"
  },
  "BlobResourceContents": {
   "properties": {
    "_meta": {
     "$ref": "#/$defs/MetaObject"
    },
    "blob": {
     "format": "byte",
     "type": "string"
    },
    "mimeType": {
     "type": "string"
    },
    "uri": {
     "format": "uri",
     "type": "string"
    }
   },
   "required": [
    "blob",
    "uri"
   ],
   "type": "object"
  },
  "CallToolResult": {
   "properties": {
    "_meta": {
     "$ref": "#/$defs/ResultMetaObject"
    },
    "content": {
     "items": {
      "$ref": "#/$defs/ContentBlock"
     },
     "type": "array"
    },
    "isError": {
     "type": "boolean"
    },
    "resultType": {
     "type": "string"
    },
    "structuredContent": {}
   },
   "required": [
    "content",
    "resultType"
   ],
   "type": "object"
  },
  "ContentBlock": {
   "anyOf": [
    {
     "$ref": "#/$defs/TextContent"
    },
    {
     "$ref": "#/$defs/ImageContent"
    },
    {
     "$ref": "#/$defs/AudioContent"
    },
    {
     "$ref": "#/$defs/ResourceLink"
    },
    {
     "$ref": "#/$defs/EmbeddedResource"
    }
   ]
  },
  "DiscoverResult": {
   "properties": {
    "_meta": {
     "$ref": "#/$defs/ResultMetaObject"
    },
    "cacheScope": {
     "enum": [
      "private",
      "public"
     ],
     "type": "string"
    },
    "capabilities": {
     "$ref": "#/$defs/ServerCapabilities"
    },
    "instructions": {
     "type": "string"
    },
    "resultType": {
     "type": "string"
    },
    "supportedVersions": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "ttlMs": {
     "minimum": 0,
     "type": "integer"
    }
   },
   "required": [
    "cacheScope",
    "capabilities",
    "resultType",
    "supportedVersions",
    "ttlMs"
   ],
   "type": "object"
  },
  "EmbeddedResource": {
   "properties": {
    "_meta": {
     "$ref": "#/$defs/MetaObject"
    },
    "annotations": {
     "$ref": "#/$defs/Annotations"
    },
    "resource": {
     "anyOf": [
      {
       "$ref": "#/$defs/TextResourceContents"
      },
      {
       "$ref": "#/$defs/BlobResourceContents"
      }
     ]
    },
    "type": {
     "const": "resource",
     "type": "string"
    }
   },
   "required": [
    "resource",
    "type"
   ],
   "type": "object"
  },
  "EmptyResult": {
   "$ref": "#/$defs/Result"
  },
  "GetPromptResult": {
   "properties": {
    "_meta": {
     "$ref": "#/$defs/ResultMetaObject"
    },
    "messages": {
     "items": {
      "$ref": "#/$defs/PromptMessage"
     },
     "type": "array"
    },
    "resultType": {
     "type": "string"
    }
   },
   "required": [
    "messages",
    "resultType"
   ],
   "type": "object"
  },
  "Icon": {
   "properties": {
    "mimeType": {
     "type": "string"
    },
    "sizes": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "src": {
     "format": "uri",
     "type": "string"
    },
    "theme": {
     "enum": [
      "dark",
      "light"
     ],
     "type": "string"
    }
   },
   "required": [
    "src"
   ],
   "type": "object"
  },
  "ImageContent": {
   "properties": {
    "_meta": {
     "$ref": "#/$defs/MetaObject"
    },
    "annotations": {
     "$ref": "#/$defs/Annotations"
    },
    "data": {
     "format": "byte",
     "type": "string"
    },
    "mimeType": {
     "type": "string"
    },
    "type": {
     "const": "image",
     "type": "string"
    }
   },
   "required": [
    "data",
    "mimeType",
    "type"
   ],
   "type": "object"
  },
  "Implementation": {
   "properties": {
    "icons": {
     "items": {
      "$ref": "#/$defs/Icon"
     },
     "type": "array"
    },
    "name": {
     "type": "string"
    },
    "title": {
     "type": "string"
    },
    "version": {
     "type": "string"
    },
    "websiteUrl": {
     "format": "uri",
     "type": "string"
    }
   },
   "required": [
    "name",
    "version"
   ],
   "type": "object"
  },
  "JSONObject": {
   "additionalProperties": {
    "$ref": "#/$defs/JSONValue"
   },
   "type": "object"
  },
  "JSONValue": {
   "anyOf": [
    {
     "$ref": "#/$defs/JSONObject"
    },
    {
     "items": {
      "$ref": "#/$defs/JSONValue"
     },
     "type": "array"
    },
    {
     "type": [
      "string",
      "integer",
      "boolean"
     ]
    }
   ]
  },
  "ListPromptsResult": {
   "properties": {
    "_meta": {
     "$ref": "#/$defs/ResultMetaObject"
    },
    "cacheScope": {
     "enum": [
      "private",
      "public"
     ],
     "type": "string"
    },
    "nextCursor": {
     "type": "string"
    },
    "prompts": {
     "items": {
      "$ref": "#/$defs/Prompt"
     },
     "type": "array"
    },
    "resultType": {
     "type": "string"
    },
    "ttlMs": {
     "minimum": 0,
     "type": "integer"
    }
   },
   "required": [
    "cacheScope",
    "prompts",
    "resultType",
    "ttlMs"
   ],
   "type": "object"
  },
  "ListToolsResult": {
   "properties": {
    "_meta": {
     "$ref": "#/$defs/ResultMetaObject"
    },
    "cacheScope": {
     "enum": [
      "private",
      "public"
     ],
     "type": "string"
    },
    "nextCursor": {
     "type": "string"
    },
    "resultType": {
     "type": "string"
    },
    "tools": {
     "items": {
      "$ref": "#/$defs/Tool"
     },
     "type": "array"
    },
    "ttlMs": {
     "minimum": 0,
     "type": "integer"
    }
   },
   "required": [
    "cacheScope",
    "resultType",
    "tools",
    "ttlMs"
   ],
   "type": "object"
  },
  "MetaObject": {
   "type": "object"
  },
  "Prompt": {
   "properties": {
    "_meta": {
     "$ref": "#/$defs/MetaObject"
    },
    "arguments": {
     "items": {
      "$ref": "#/$defs/PromptArgument"
     },
     "type": "array"
    },
    "icons": {
     "items": {
      "$ref": "#/$defs/Icon"
     },
     "type": "array"
    },
    "name": {
     "type": "string"
    },
    "title": {
     "type": "string"
    }
   },
   "required": [
    "name"
   ],
   "type": "object"
  },
  "PromptArgument": {
   "properties": {
    "name": {
     "type": "string"
    },
    "required": {
     "type": "boolean"
    },
    "title": {
     "type": "string"
    }
   },
   "required": [
    "name"
   ],
   "type": "object"
  },
  "PromptMessage": {
   "properties": {
    "content": {
     "$ref": "#/$defs/ContentBlock"
    },
    "role": {
     "$ref": "#/$defs/Role"
    }
   },
   "required": [
    "content",
    "role"
   ],
   "type": "object"
  },
  "ResourceLink": {
   "properties": {
    "_meta": {
     "$ref": "#/$defs/MetaObject"
    },
    "annotations": {
     "$ref": "#/$defs/Annotations"
    },
    "icons": {
     "items": {
      "$ref": "#/$defs/Icon"
     },
     "type": "array"
    },
    "mimeType": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "size": {
     "type": "integer"
    },
    "title": {
     "type": "string"
    },
    "type": {
     "const": "resource_link",
     "type": "string"
    },
    "uri": {
     "format": "uri",
     "type": "string"
    }
   },
   "required": [
    "name",
    "type",
    "uri"
   ],
   "type": "object"
  },
  "Result": {
   "additionalProperties": {},
   "properties": {
    "_meta": {
     "$ref": "#/$defs/ResultMetaObject"
    },
    "resultType": {
     "type": "string"
    }
   },
   "required": [
    "resultType"
   ],
   "type": "object"
  },
  "ResultMetaObject": {
   "properties": {
    "io.modelcontextprotocol/serverInfo": {
     "$ref": "#/$defs/Implementation"
    }
   },
   "type": "object"
  },
  "Role": {
   "enum": [
    "assistant",
    "user"
   ],
   "type": "string"
  },
  "ServerCapabilities": {
   "properties": {
    "completions": {
     "$ref": "#/$defs/JSONObject"
    },
    "experimental": {
     "additionalProperties": {
      "$ref": "#/$defs/JSONObject"
     },
     "type": "object"
    },
    "extensions": {
     "additionalProperties": {
      "$ref": "#/$defs/JSONObject"
     },
     "type": "object"
    },
    "logging": {
     "$ref": "#/$defs/JSONObject"
    },
    "prompts": {
     "properties": {
      "listChanged": {
       "type": "boolean"
      }
     },
     "type": "object"
    },
    "resources": {
     "properties": {
      "listChanged": {
       "type": "boolean"
      },
      "subscribe": {
       "type": "boolean"
      }
     },
     "type": "object"
    },
    "tools": {
     "properties": {
      "listChanged": {
       "type": "boolean"
      }
     },
     "type": "object"
    }
   },
   "type": "object"
  },
  "TextContent": {
   "properties": {
    "_meta": {
     "$ref": "#/$defs/MetaObject"
    },
    "annotations": {
     "$ref": "#/$defs/Annotations"
    },
    "text": {
     "type": "string"
    },
    "type": {
     "const": "text",
     "type": "string"
    }
   },
   "required": [
    "text",
    "type"
   ],
   "type": "object"
  },
  "TextResourceContents": {
   "properties": {
    "_meta": {
     "$ref": "#/$defs/MetaObject"
    },
    "mimeType": {
     "type": "string"
    },
    "text": {
     "type": "string"
    },
    "uri": {
     "format": "uri",
     "type": "string"
    }
   },
   "required": [
    "text",
    "uri"
   ],
   "type": "object"
  },
  "Tool": {
   "properties": {
    "_meta": {
     "$ref": "#/$defs/MetaObject"
    },
    "annotations": {
     "$ref": "#/$defs/ToolAnnotations"
    },
    "icons": {
     "items": {
      "$ref": "#/$defs/Icon"
     },
     "type": "array"
    },
    "inputSchema": {
     "additionalProperties": {},
     "properties": {
      "$schema": {
       "type": "string"
      },
      "type": {
       "const": "object",
       "type": "string"
      }
     },
     "required": [
      "type"
     ],
     "type": "object"
    },
    "name": {
     "type": "string"
    },
    "outputSchema": {
     "additionalProperties": {},
     "properties": {
      "$schema": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "title": {
     "type": "string"
    }
   },
   "required": [
    "inputSchema",
    "name"
   ],
   "type": "object"
  },
  "ToolAnnotations": {
   "properties": {
    "destructiveHint": {
     "type": "boolean"
    },
    "idempotentHint": {
     "type": "boolean"
    },
    "openWorldHint": {
     "type": "boolean"
    },
    "readOnlyHint": {
     "type": "boolean"
    },
    "title": {
     "type": "string"
    }
   },
   "type": "object"
  }
 }
}
